{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "kids-games-3.vercel.app"
        }
      ],
      "destination": "https://lumi.aiu-media.com/$1",
      "statusCode": 301,
      "missing": [
        {
          "type": "header",
          "key": "x-aiu-proxy"
        }
      ]
    }
  ]
}
